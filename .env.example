# App Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-in-production-super-secret-key-at-least-32-chars

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=attendance_saas
POSTGRES_HOST=db
POSTGRES_PORT=5435
BACKEND_PORT=8001

# Computed async connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/attendance_saas
